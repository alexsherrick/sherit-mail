{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sherit Mail",
  "mainBinaryName": "SheritMail",
  "identifier": "com.sheritlabs.mail",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Sherit Labs",
    "copyright": "Sherit Labs",
    "category": "Productivity",
    "shortDescription": "Every address you own, in one fast inbox.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE-WITH-YOUR-UPDATER-PUBLIC-KEY",
      "endpoints": [
        "https://mail.yourdomain.example/dl/windows/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
